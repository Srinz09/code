# Meta (Facebook/Instagram) Pixel + Conversions API
# See README.md "Meta Ads tracking" section for setup steps.

# Pixel ID from Meta Events Manager. Public — shipped to the browser.
NEXT_PUBLIC_META_PIXEL_ID=

# System user access token with ads_management permission, used server-side
# to send the same lead event via the Conversions API. Never expose this
# to the browser — do NOT prefix it with NEXT_PUBLIC_.
META_CAPI_ACCESS_TOKEN=

# Optional: Meta Events Manager "Test Events" code, for verifying events
# while testing. Remove/leave blank once verified so real traffic isn't
# tagged as test data.
META_CAPI_TEST_EVENT_CODE=
